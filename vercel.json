{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "upgraded_site",
          "format": "url",
          "env": "UPGRADED_SITE_URL"
        }
      ]
    },
    "upgraded_site": {
      "root": "upgraded_site",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
